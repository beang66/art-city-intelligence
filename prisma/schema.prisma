generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model City {
  id            String           @id @default(cuid())
  slug          String           @unique
  name          String
  country       String
  latitude      Float
  longitude     Float
  artCityIndex  Float
  cityType      String
  coreDna       String
  indicators    IndicatorValue[]
  sources       Source[]
  validations   Validation[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model Indicator {
  id          String           @id @default(cuid())
  key         String           @unique
  label       String
  description String
  values      IndicatorValue[]
}

model IndicatorValue {
  id           String    @id @default(cuid())
  cityId       String
  indicatorId  String
  score        Float
  uncertainty  Float?
  measuredAt   DateTime
  city         City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  indicator    Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@unique([cityId, indicatorId, measuredAt])
}

model Source {
  id          String   @id @default(cuid())
  cityId      String
  title       String
  url         String?
  publisher   String
  observedAt  DateTime
  city        City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
}

model Validation {
  id          String   @id @default(cuid())
  cityId      String
  state       String
  note        String?
  reviewedAt  DateTime?
  city        City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
}
